# --- Required ---
# MongoDB Atlas connection string (database name included).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/renteasy?retryWrites=true&w=majority

# Base URL of the Next.js/BetterAuth client (no trailing slash).
# Multiple allowed origins can be provided comma separated.
CLIENT_URL=http://localhost:3001
# BETTER_AUTH_URL must match the client origin where /api/auth/jwks is served.
BETTER_AUTH_URL=http://localhost:3001

# --- Payments (Stripe test or live keys) ---
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally or the Vercel webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Optional ---
# Local listener port (Vercel provides its own).
PORT=5000
# Set to "true" only if client preview deployments must call this API.
ALLOW_VERCEL_PREVIEWS=false
# Maximum time a request may take before the platform timeout (ms).
REQUEST_TIMEOUT_MS=25000
